# Music Streaming App - Environment Configuration
# Copy this file to .env.local and fill in your values

# API Configuration
VITE_API_URL=http://localhost:3001
VITE_API_KEY=your_api_key_here

# Music Service Integration (optional)
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_SPOTIFY_CLIENT_SECRET=your_spotify_secret

# Apple Music Integration (optional)
VITE_APPLE_MUSIC_KEY=your_apple_music_key

# Development Settings
VITE_DEBUG=false
VITE_LOG_LEVEL=info

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_SMOOTH_SCROLL=true
VITE_ENABLE_ANIMATIONS=true
